---
import { SITE, CATEGORIES } from '../site.js';
import '../styles.css';
const { title, description = SITE.desc, image, imageAlt, imageWidth, imageHeight, type = 'website', noindex = false, publishedTime, modifiedTime, section } = Astro.props;
const t = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.full}`;
const ogImage = new URL(image || '/og.png', SITE.url);
// Dimensions are only stated for our own 1200x630 cards (default or an explicit size); post covers keep their natural size.
const ogW = image ? imageWidth : 1200; const ogH = image ? imageHeight : 630;
const ogAlt = imageAlt || (image ? t : 'PPRGaming: Star Citizen and gaming news');
const canonical = new URL(Astro.url.pathname, SITE.url);
const orgLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, alternateName: SITE.full, url: `${SITE.url}/`, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` }, sameAs: [SITE.x] },
  { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: `${SITE.url}/`, publisher: { '@id': `${SITE.url}/#org` } },
] };
const bookHref = SITE.amazonTag
  ? `${SITE.book.url}${SITE.book.url.includes('?') ? '&' : '?'}tag=${SITE.amazonTag}`
  : SITE.book.url;
---
<!doctype html><html lang="en"><head>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-37MW8FJNNR"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-37MW8FJNNR');</script>

<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{t}</title><meta name="description" content={description}/>{noindex ? <meta name="robots" content="noindex,follow"/> : <meta name="robots" content="index,follow,max-image-preview:large"/>}{!noindex && <link rel="canonical" href={canonical}/>}
<meta property="og:title" content={t}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/>
<meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/>{ogW && <meta property="og:image:width" content={String(ogW)}/>}{ogH && <meta property="og:image:height" content={String(ogH)}/>}<meta property="og:image:alt" content={ogAlt}/><meta property="og:site_name" content={SITE.name}/><meta property="og:locale" content="en_US"/>{publishedTime && <meta property="article:published_time" content={publishedTime}/>}{modifiedTime && <meta property="article:modified_time" content={modifiedTime}/>}{section && <meta property="article:section" content={section}/>}
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@PPRGamers"/><meta name="twitter:title" content={t}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><meta name="twitter:image:alt" content={ogAlt}/>
<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/png" href="/favicon.png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="alternate" type="application/rss+xml" title="PPRGaming" href="/rss.xml"/>
<script type="application/ld+json" set:html={JSON.stringify(orgLd)}></script>
{SITE.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
</head><body>
<header class="top"><div class="wrap nav">
<a class="logo" href="/"><img src="/logo.png" alt="PPRGaming" height="40" width="62"/></a>
<input type="checkbox" id="m" hidden/><label for="m" class="burger">☰</label>
<nav>
<a href="/category/star-citizen/">Star Citizen</a>
<a href="/gta-6/" class="nav-gta">GTA 6</a>
{Object.entries(CATEGORIES).filter(([k])=>k!=='star-citizen').map(([k,v])=><a href={`/category/${k}/`}>{v}</a>)}
<a href="/screenshots/">Screenshots</a><a href="/gear/">Gear</a><a href="/about/">About</a><a class="btn" href="/support/">Support</a>
</nav></div></header>
<main class="wrap"><slot/></main>
<footer class="foot"><div class="wrap">
<p><strong>PPRGaming</strong> — {SITE.full}. Independent gaming news. Not affiliated with Cloud Imperium Games or Roberts Space Industries.</p>
<p><a href="/gear/">Gear</a> · <a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/editorial/">Editorial &amp; Corrections</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/rss.xml">RSS</a> · <a href={SITE.x}>X @PPRGamers</a></p>
<p class="foot-book">New dark fantasy book: <a href={bookHref} target="_blank" rel="noopener sponsored">The Ashen Vampire by J.R. Carter</a></p>
<p class="small">As an Amazon Associate I earn from qualifying purchases. © {new Date().getFullYear()} PPRGaming</p>
</div></footer></body></html>
