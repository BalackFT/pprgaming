---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import Ad from '../../components/Ad.astro'; import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import GtaCountdown from '../../components/GtaCountdown.astro';
import { isGta6 } from '../../gta6.js';
const posts = (await getCollection('posts', p => !p.data.draft && isGta6(p))).sort((a,b)=>b.data.date-a.data.date);
const latest = posts.slice(0,3); const rest = posts.slice(3);
const L = (href, text) => ({ href, text });
const confirmed = [
  { fact: 'GTA VI is out now on PlayStation 5 and Xbox Series X|S. It launched Thursday, November 19, 2026.', src: [L('https://x.com/RockstarGames/status/2123417684985495637','Rockstar on X'), L('https://www.rockstargames.com/VI','Rockstar'), L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two')] },
  { fact: 'It unlocked at midnight local time, country by country. In the US that was one moment for everyone: 12:00 AM ET Thursday, November 19 (9:00 PM PT Wednesday).', src: [L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation Support'), L('https://blog.playstation.com/2026/11/10/pre-load-grand-theft-auto-vi-on-ps5-starting-today/','PlayStation Blog'), L('https://in.ign.com/grand-theft-auto-vi/276047/gta-6-preload-times-and-install-size-confirmed-rockstar-announces-physical-cover-art-poster-and-map','IGN, relaying Rockstar\'s list')] },
  { fact: 'Standard Edition is $79.99. The digital-only Ultimate Edition is $99.99. Boxed copies are code-in-box, with no disc.', src: [L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two'), L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation Support')] },
  { fact: 'Anything bought before November 20 includes the Vintage Vice City Pack (the \'55 Vapid Stanier and garage, Jason and Lucia outfits and hairstyles, and a weapon pattern), so that offer closed after Thursday, November 19.', src: [L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two')] },
  { fact: 'Xbox Cloud Gaming is live on Xbox One and Series X|S. Microsoft said streaming would start at 1:00 AM ET on November 19, and Xbox\'s official game and store pages now list Grand Theft Auto VI as available and cloud playable on Xbox consoles, at Xbox Series S settings. The game is bought separately.', src: [L('https://news.xbox.com/en-us/2026/11/10/grand-theft-auto-6-comes-to-xbox-cloud-gaming-november-19/','Xbox Wire'), L('https://www.xbox.com/en-US/games/grand-theft-auto-vi','Xbox'), L('https://www.xbox.com/en-US/games/store/grand-theft-auto-vi/9nl3wwnzlzzn','Xbox Store')] },
  { fact: 'GTA VI targets 30fps on every console, and Rockstar says there will be no 60fps or 40fps mode on PS5 Pro. The Pro adds ray-traced shadows and PSSR upscaling instead.', src: [L('https://kotaku.com/gta-6-wont-get-a-60-fps-mode-even-on-ps5-pro-because-its-not-powerful-enough-2000755979','Kotaku, quoting Rockstar'), L('https://gameinformer.com/2026/11/10/grand-theft-auto-vi-will-run-at-30-fps-on-all-consoles-but-ps5-pro-will-feature-improved','Game Informer')] },
  { fact: 'Take-Two says GTA VI hit $3.79 billion in day-one retail sales, a company estimate through the end of November 19 worldwide, and sold 32.5 million units before release. It calls that the biggest entertainment launch in history.', src: [L('https://www.take2games.com/ir/news/grand-theft-auto-vi-shatters-entertainment-box-office-records','Take-Two'), L('https://www.businesswire.com/news/home/20261120446139/en/','Business Wire')] },
  { fact: 'Sony says GTA VI is the biggest game launch in PlayStation history. From November 19 to 22, more than 39 million unique players played it on PS5 (players, not copies sold), logging 683 million hours, an average of 17.4 hours each. Sony also says it set a new record for concurrent players on PlayStation, without giving the number.', src: [L('https://blog.playstation.com/2026/11/23/thank-you-for-making-grand-theft-auto-vi-the-biggest-launch-in-playstation-history/','PlayStation Blog'), L('https://x.com/PlayStation/status/2125009125322957131','@PlayStation on X')] },
  { fact: 'GTA+ ($7.99 a month in the US) now includes optional GTA VI benefits: a bonus sports car and garage, discounts and other bonuses. They only last while the membership is active, and you can switch the boosts off in the pause menu under Account.', src: [L('https://www.rockstargames.com/gta-plus/benefits','Rockstar GTA+'), L('https://store.playstation.com/en-us/product/UP1004-PPSA16755_00-GTAPLUS00001T01M','PlayStation Store'), L('https://www.polygon.com/gta-6-plus-membership-benefits-exclusive-car-garage/','Polygon')] },
  { fact: 'Rockstar\'s first post-launch update went out Monday morning, November 23, on PS5 and Xbox Series X|S. Its notes list fixes for several crashes, weather not changing for long stretches, autosave not working correctly, story phone calls not triggering, a Wanted Level you couldn\'t lose, the gym deadlift bar, and partners not handing over bags for fences.', src: [L('https://support.rockstargames.com/articles/sN5pEdFYZdlvijKXd6xpJ/','Rockstar Support: Launch Updates'), L('https://x.com/RockstarSupport/status/2124876263357648915','@RockstarSupport')] },
  { fact: 'Grand Theft Auto VI: The Album (Deluxe Edition) is out now, adding 23 bonus tracks from across the game, including The Dare, Slayyyter, Denzel Curry, HEALTH, Power Trip and Real Dimez x Sexyy Red.', src: [L('https://x.com/RockstarGames/status/2124867612450386302','Rockstar on X')] },
  { fact: 'The free printable cover art poster and map of Leonida are now on Rockstar\'s downloads page, both at 19.25 x 26.33 inches. They went up Thursday morning, November 19.', src: [L('https://www.rockstargames.com/VI/downloads','Rockstar downloads')] },
];
const open = [
  { fact: 'Reviews.', note: 'Reviews went up Wednesday, November 18. Metacritic shows a 99 Metascore from 158 critic reviews (checked Friday morning), and OpenCritic showed a 98 Top Critic Average on Wednesday.', src: [L('https://www.metacritic.com/game/grand-theft-auto-vi/','Metacritic'),L('https://opencritic.com/game/15398/grand-theft-auto-vi','OpenCritic')] },
  { fact: 'A PC version.', note: 'Not announced. One report points to early 2027, and Rockstar hasn\'t said a word about it.', src: [L('https://www.usatoday.com/story/tech/gaming/2026/11/16/gta-6-everything-to-know-preorder-story-actors-cost/92711409007/','USA Today')] },
  { fact: 'Multiplayer.', note: 'Rockstar still calls GTA VI a single-player experience and hasn\'t announced an online mode. GTA Online in GTA V keeps running.', src: [L('https://uk.pcmag.com/games/168419/felony-fun-with-friends-can-you-play-gta-6-online-at-launch-this-week','PCMag')] },
];
const official = [
  L('https://www.rockstargames.com/VI','Rockstar: Grand Theft Auto VI'), L('https://www.rockstargames.com/newswire','Rockstar Newswire'),
  L('https://x.com/RockstarGames','@RockstarGames'), L('https://x.com/RockstarSupport','@RockstarSupport'),
  L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation GTA VI support'), L('https://news.xbox.com/en-us/','Xbox Wire'),
  L('https://ir.take2games.com/','Take-Two investor relations'),
];
---
<Base title="GTA 6 Hub" image="/og-gta6.jpg" imageWidth={1200} imageHeight={630} imageAlt="Grand Theft Auto VI official key art with the text GTA 6 Launch Week, PPRGaming" description="Everything PPRGaming has on Grand Theft Auto VI: official sales and player numbers, patches, editions and price, Xbox Cloud Gaming, tips, and every story we've written.">
<section class="gta" id="gta-6">
  <p class="gta-kicker">Out now · PS5 and Xbox Series X|S</p>
  <h1>Grand Theft Auto <em>VI</em></h1>
  <p class="gta-lede">GTA VI has been out since Thursday, Nov 19, on PS5 and Xbox Series X|S, with Xbox Cloud Gaming on Xbox One too. Rockstar's first patch landed Monday, Nov 23. Everything we have on it lives on this page. The facts up top are only things Rockstar, Sony or Microsoft have put in writing, and anything still unconfirmed is marked that way.</p>
  <GtaCountdown/>
  <div class="status gta-status">
    <div><b>Nov 19, 2026</b><span>PS5 and Xbox Series X|S</span></div>
    <div><b>First patch out</b><span>Nov 23: crash, autosave and story phone call fixes</span></div>
    <div><b>$3.79B day one</b><span>Take-Two estimate through Nov 19, 32.5M sold pre-release</span></div>
    <div><b>39M+ PS5 players</b><span>Sony, Nov 19 to 22: biggest PlayStation launch ever</span></div>
    <div><b>Metacritic 99</b><span>Metascore from 158 critic reviews</span></div>
    <div><b>$79.99 / $99.99</b><span>Standard / Ultimate (digital only)</span></div>
    <div><b>Cloud Gaming</b><span>Xbox One and Series X|S, at Series S settings</span></div>
    <div><b>PC: not announced</b><span>Nothing official from Rockstar</span></div>
  </div>
  <p class="small gta-asof">Facts checked Nov 23, 2026, Metacritic rechecked Nov 24. Take-Two's day-one sales added Nov 20, Sony's PS5 player numbers added Nov 23, and Rockstar's first patch added Nov 23. We keep this page updated as Rockstar, Sony and Microsoft confirm more.</p>
  <p class="gta-tipsbox"><b>New: <a href="/gta-6/tips/">GTA 6 Tips &amp; Tricks (No Spoilers)</a></b>. Settings, camera, money, driving and the cops, each one sourced, plus the first-person workaround. No story, nothing you haven't played yet.</p>
</section>

{latest.length>0 && <><h2 class="sec">Latest GTA 6 stories</h2><div class="grid">{latest.map(p=><Card post={p}/>)}</div></>}

<div class="gta-two">
  <section><h2 class="sec">Confirmed</h2><ul class="gta-list">{confirmed.map(c=><li>{c.fact} <span class="gta-src">{c.src.map((s,i)=><>{i>0 && ', '}<a href={s.href} rel="noopener" target="_blank">{s.text}</a></>)}</span></li>)}</ul></section>
  <section><h2 class="sec">Not confirmed yet</h2><ul class="gta-list gta-open">{open.map(c=><li><b>{c.fact}</b> {c.note} <span class="gta-src">{c.src.map((s,i)=><>{i>0 && ', '}<a href={s.href} rel="noopener" target="_blank">{s.text}</a></>)}</span></li>)}</ul>
  <h3 class="gta-h3">Official sources</h3><ul class="gta-links">{official.map(s=><li><a href={s.href} rel="noopener" target="_blank">{s.text}</a></li>)}</ul></section>
</div>

<h2 class="sec">{rest.length>0 ? 'More GTA 6 coverage' : 'GTA 6 coverage'}</h2>
{(rest.length>0 ? rest : posts).length>0
  ? <div class="grid">{(rest.length>0 ? rest : posts).map(p=><Card post={p}/>)}</div>
  : <p>No GTA 6 stories yet, check back soon.</p>}
<Ad unit="category"/>
<Newsletter/>
</Base>
