---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import Ad from '../../components/Ad.astro'; import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import GtaCountdown from '../../components/GtaCountdown.astro';
import { isGta6, UNLOCK_TIMES } from '../../gta6.js';
const posts = (await getCollection('posts', p => !p.data.draft && isGta6(p))).sort((a,b)=>b.data.date-a.data.date);
const latest = posts.slice(0,3); const rest = posts.slice(3);
const L = (href, text) => ({ href, text });
const confirmed = [
  { fact: 'GTA VI is out now on PlayStation 5 and Xbox Series X|S. It launched Thursday, November 19, 2026.', src: [L('https://x.com/RockstarGames/status/2123417684985495637','Rockstar on X'), L('https://www.rockstargames.com/VI','Rockstar'), L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two')] },
  { fact: 'It unlocks at midnight local time, country by country. In the US that is one moment for everyone: 12:00 AM ET Thursday, which is 9:00 PM PT Wednesday.', src: [L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation Support'), L('https://blog.playstation.com/2026/11/10/pre-load-grand-theft-auto-vi-on-ps5-starting-today/','PlayStation Blog'), L('https://in.ign.com/grand-theft-auto-vi/276047/gta-6-preload-times-and-install-size-confirmed-rockstar-announces-physical-cover-art-poster-and-map','IGN, relaying Rockstar\'s list')] },
  { fact: 'Standard Edition is $79.99. The digital-only Ultimate Edition is $99.99. Boxed copies are code-in-box, with no disc.', src: [L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two'), L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation Support')] },
  { fact: 'Anything bought before November 20 includes the Vintage Vice City Pack (the \'55 Vapid Stanier and garage, Jason and Lucia outfits and hairstyles, and a weapon pattern), so Thursday, November 19 is the last day.', src: [L('https://taketwointeractivesoftwareinc.gcs-web.com/news-releases/news-release-details/rockstar-games-announces-pre-orders-grand-theft-auto-vi/','Take-Two')] },
  { fact: 'Xbox Cloud Gaming is live on Xbox One and Series X|S. Microsoft said streaming would start at 1:00 AM ET on November 19, and Xbox\'s official game and store pages now list Grand Theft Auto VI as available and cloud playable on Xbox consoles, at Xbox Series S settings. The game is bought separately.', src: [L('https://news.xbox.com/en-us/2026/11/10/grand-theft-auto-6-comes-to-xbox-cloud-gaming-november-19/','Xbox Wire'), L('https://www.xbox.com/en-US/games/grand-theft-auto-vi','Xbox'), L('https://www.xbox.com/en-US/games/store/grand-theft-auto-vi/9nl3wwnzlzzn','Xbox Store')] },
  { fact: 'GTA VI targets 30fps on every console, and Rockstar says there will be no 60fps or 40fps mode on PS5 Pro. The Pro adds ray-traced shadows and PSSR upscaling instead.', src: [L('https://kotaku.com/gta-6-wont-get-a-60-fps-mode-even-on-ps5-pro-because-its-not-powerful-enough-2000755979','Kotaku, quoting Rockstar'), L('https://gameinformer.com/2026/11/10/grand-theft-auto-vi-will-run-at-30-fps-on-all-consoles-but-ps5-pro-will-feature-improved','Game Informer')] },
  { fact: 'The free printable cover art poster and map of Leonida are now on Rockstar\'s downloads page, both at 19.25 x 26.33 inches. They went up Thursday morning, November 19.', src: [L('https://www.rockstargames.com/VI/downloads','Rockstar downloads')] },
];
const open = [
  { fact: 'Reviews.', note: 'Reviews went up Wednesday, November 18. Metacritic shows a 99 Metascore from 156 critic reviews (checked Thursday morning), and OpenCritic showed a 98 Top Critic Average on Wednesday.', src: [L('https://www.metacritic.com/game/grand-theft-auto-vi/','Metacritic'),L('https://opencritic.com/game/15398/grand-theft-auto-vi','OpenCritic')] },
  { fact: 'A PC version.', note: 'Not announced. One report points to early 2027, and Rockstar hasn\'t said a word about it.', src: [L('https://www.usatoday.com/story/tech/gaming/2026/11/16/gta-6-everything-to-know-preorder-story-actors-cost/92711409007/','USA Today')] },
  { fact: 'Multiplayer.', note: 'Rockstar still calls GTA VI a single-player experience and hasn\'t announced an online mode. GTA Online in GTA V keeps running.', src: [L('https://uk.pcmag.com/games/168419/felony-fun-with-friends-can-you-play-gta-6-online-at-launch-this-week','PCMag')] },
];
const official = [
  L('https://www.rockstargames.com/VI','Rockstar: Grand Theft Auto VI'), L('https://www.rockstargames.com/newswire','Rockstar Newswire'),
  L('https://x.com/RockstarGames','@RockstarGames'), L('https://x.com/RockstarSupport','@RockstarSupport'),
  L('https://www.playstation.com/en-us/support/games/gta-vi-support/','PlayStation GTA VI support'), L('https://news.xbox.com/en-us/','Xbox Wire'),
  L('https://ir.take2games.com/','Take-Two investor relations'),
];
---
<Base title="GTA 6 Launch Week" image="/og-gta6.jpg" imageWidth={1200} imageHeight={630} imageAlt="Grand Theft Auto VI official key art with the text GTA 6 Launch Week, PPRGaming" description="Everything PPRGaming has on Grand Theft Auto VI: unlock times in ET, pre-load, editions and price, plus every story, updated through launch week.">
<section class="gta" id="gta-6">
  <p class="gta-kicker">Launch week · Nov 17 to 23</p>
  <h1>Grand Theft Auto <em>VI</em></h1>
  <p class="gta-lede">It's out. GTA VI unlocked in the US at midnight Eastern on Thursday, Nov 19, and was already live in New Zealand and Europe. Xbox Cloud Gaming is up on Xbox One and Series X|S as well. Everything we have on it lives on this page. The facts up top are only things Rockstar, Sony or Microsoft have put in writing, and anything still unconfirmed is marked that way.</p>
  <GtaCountdown/>
  <div class="status gta-status">
    <div><b>Nov 19, 2026</b><span>PS5 and Xbox Series X|S</span></div>
    <div><b>Out now in the US</b><span>Unlocked 12:00 AM ET, Thursday Nov 19</span></div>
    <div><b>Metacritic 99</b><span>Metascore from 156 critic reviews</span></div>
    <div><b>$79.99 / $99.99</b><span>Standard / Ultimate (digital only)</span></div>
    <div><b>Cloud Gaming</b><span>Live on Xbox consoles from 1:00 AM ET</span></div>
    <div><b>PC: not announced</b><span>Nothing official from Rockstar</span></div>
  </div>
  <p class="small gta-asof">Facts last checked 7:45 AM ET, Nov 19, 2026. We update this page through launch week.</p>
</section>

{latest.length>0 && <><h2 class="sec">Latest GTA 6 stories</h2><div class="grid">{latest.map(p=><Card post={p}/>)}</div></>}

<h2 class="sec" id="unlock">Unlock times in ET</h2>
<p>Rockstar is unlocking the game at midnight local time in each country, so the US is one of the last places to get it. Players in New Zealand and Australia will be well into it by Wednesday morning for us. Expect spoilers in your feed from then on.</p>
<div class="tbl-wrap"><table class="gta-tbl"><thead><tr><th>Where</th><th>Rockstar's unlock</th><th>In Eastern Time</th></tr></thead><tbody>
{UNLOCK_TIMES.map(r=><tr class={r.us?'us':''}><td>{r.region}</td><td>{r.local}</td><td><b>{r.et}</b></td></tr>)}
</tbody></table></div>
<p class="small">Times converted from Rockstar's midnight-local schedule (<a href="https://in.ign.com/grand-theft-auto-vi/276047/gta-6-preload-times-and-install-size-confirmed-rockstar-announces-physical-cover-art-poster-and-map" rel="noopener">IGN's table</a>, <a href="https://www.playstation.com/en-us/support/games/gta-vi-support/" rel="noopener">PlayStation Support</a>). Xbox Cloud Gaming opened separately at 1:00 AM ET Thursday.</p>

<div class="gta-two">
  <section><h2 class="sec">Confirmed</h2><ul class="gta-list">{confirmed.map(c=><li>{c.fact} <span class="gta-src">{c.src.map((s,i)=><>{i>0 && ', '}<a href={s.href} rel="noopener" target="_blank">{s.text}</a></>)}</span></li>)}</ul></section>
  <section><h2 class="sec">Not confirmed yet</h2><ul class="gta-list gta-open">{open.map(c=><li><b>{c.fact}</b> {c.note} <span class="gta-src">{c.src.map((s,i)=><>{i>0 && ', '}<a href={s.href} rel="noopener" target="_blank">{s.text}</a></>)}</span></li>)}</ul>
  <h3 class="gta-h3">Official sources</h3><ul class="gta-links">{official.map(s=><li><a href={s.href} rel="noopener" target="_blank">{s.text}</a></li>)}</ul></section>
</div>

<h2 class="sec">{rest.length>0 ? 'More GTA 6 coverage' : 'GTA 6 coverage'}</h2>
{(rest.length>0 ? rest : posts).length>0
  ? <div class="grid">{(rest.length>0 ? rest : posts).map(p=><Card post={p}/>)}</div>
  : <p>No GTA 6 stories yet, check back soon.</p>}
<Ad unit="category"/>
<Newsletter/>
</Base>
