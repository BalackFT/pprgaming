---
import Base from '../../layouts/Base.astro'; import Ad from '../../components/Ad.astro'; import Newsletter from '../../components/Newsletter.astro'; import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content'; import { CATEGORIES, SITE } from '../../site.js';
export async function getStaticPaths(){ const ps = await getCollection('posts', p=>!p.data.draft); return ps.map(p=>({params:{slug:p.slug},props:{post:p}})); }
const { post } = Astro.props; const { Content } = await post.render();
const others = (await getCollection('posts', p=>!p.data.draft && p.slug!==post.slug)).sort((a,b)=>b.data.date-a.data.date);
const related = others.filter(p=>p.data.category===post.data.category).slice(0,3);
// More stories: same category / Star Citizen / shared tags first (newest first), then fill with the newest stories.
const tagSet = new Set(post.data.tags.map(t=>t.toLowerCase()));
const isMatch = p => p.data.category===post.data.category || (post.data.starCitizen && p.data.starCitizen) || p.data.tags.some(t=>tagSet.has(t.toLowerCase()));
const more = [...others.filter(isMatch), ...others.filter(p=>!isMatch(p))].slice(0,4);
const ld = { '@context':'https://schema.org','@type':'NewsArticle',headline:post.data.title,datePublished:post.data.date.toISOString(),author:{'@type':'Organization',name:post.data.author ?? 'PPRGaming'},publisher:{'@type':'Organization',name:'PPRGaming'},description:post.data.description, ...(post.data.image?{image:new URL(post.data.image, SITE.url).href}:{}) };
---
<Base title={post.data.title} description={post.data.description} type="article" image={post.data.image}>
<script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
<div class="layout"><article class="post">
<a class="tag" href={`/category/${post.data.category}/`}>{CATEGORIES[post.data.category]}</a>
<h1>{post.data.title}</h1>
<p class="meta">By {post.data.author ?? 'PPRGaming'} · {post.data.date.toLocaleDateString('en-US',{dateStyle:'long',timeZone:'America/New_York'})}</p>
{post.data.image
  ? <figure class="hero"><img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} width="1600" height="900" fetchpriority="high"/>{post.data.imageCredit && <figcaption>{post.data.imageCredit}</figcaption>}</figure>
  : <div class={`hero hero-fallback ${post.data.starCitizen ? 'sc' : ''}`}><span>{CATEGORIES[post.data.category]}</span></div>}
<Ad unit="article-top"/>
<div class="post-body"><Content/></div>
{post.data.starCitizen && <div class="ref"><div>Starting Star Citizen? Referral code <code>{SITE.rsiReferral}</code> gets you bonus starting credits.</div><a class="btn" href="https://robertsspaceindustries.com/enlist?referral=STAR-KRBQ-RNS9" rel="nofollow">Enlist →</a></div>}
{post.data.sources.length>0 && <div class="sources"><strong>Sources</strong><ul>{post.data.sources.map(s=><li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ul></div>}
<section class="more-stories"><h2>More stories</h2><div class="grid grid-sm">{more.map(p=><Card post={p} compact/>)}</div><p class="small"><a href="/news/">All news →</a></p></section>
<Ad unit="article-bottom"/><Newsletter/>
</article>
<aside class="side"><Ad unit="sidebar" /><h3>Related</h3>{related.map(p=><Card post={p}/>)}</aside></div>
</Base>
