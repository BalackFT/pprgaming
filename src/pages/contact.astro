---
import Base from '../layouts/Base.astro'; import { SITE } from '../site.js';
---
<Base title="Contact"><div class="prose"><h1>Contact</h1>
<p>Tips, corrections, press releases or sponsorship inquiries — we'd love to hear from you.</p>
<p>Email: <a href="mailto:contact@pprgaming.com">contact@pprgaming.com</a> <em>(set up this mailbox, e.g. via Cloudflare Email Routing)</em> · X: <a href={SITE.x}>@PPRGamers</a></p>
<!-- TODO: point action to Formspree / Netlify Forms / Cloudflare form handler -->
<form action="#" method="post" onsubmit="alert('Contact form coming soon — please email us.');return false;" style="display:grid;gap:10px;max-width:520px">
<input type="text" name="name" placeholder="Name" required/><input type="email" name="email" placeholder="Email" required/><textarea name="msg" rows="6" placeholder="Message" required></textarea><button>Send</button></form>
</div></Base>
