---
import { CATEGORIES } from '../site.js';
const { post } = Astro.props;
const label = CATEGORIES[post.data.category] ?? post.data.category;
---
<a class="card" href={`/news/${post.slug}/`}>
  <div class="thumb">
    {post.data.image
      ? <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" decoding="async" width="1600" height="900"/>
      : <div class={`thumb-fallback ${post.data.starCitizen ? 'sc' : ''}`}><span>{label}</span></div>}
  </div>
  <span class="tag">{label}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <time>{post.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'America/New_York'})}</time>
</a>
