---
import { CATEGORIES } from '../site.js';
const { post } = Astro.props;
---
<a class="card" href={`/news/${post.slug}/`}>
  <span class="tag">{CATEGORIES[post.data.category] ?? post.data.category}</span>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <time>{post.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'})}</time>
</a>
