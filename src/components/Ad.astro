---
import { SITE } from '../site.js';
const { unit = "default" } = Astro.props;
---
{(SITE.adsenseClient && SITE.adsenseAds) ? (
<div class="ad" data-ad-slot={unit}>
  <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={unit} data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>
) : null}
