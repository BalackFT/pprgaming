---
import { SITE } from '../site.js';
const book = SITE.book;
const href = SITE.amazonTag
  ? `${book.url}${book.url.includes('?') ? '&' : '?'}tag=${SITE.amazonTag}`
  : book.url;
---
<aside class="book-promo" aria-label="Book promotion">
  <div class="book-promo-inner">
    <a class="book-promo-cover" href={href} rel="noopener sponsored" target="_blank">
      <img src={book.cover} alt={`Cover of ${book.title} by ${book.author}`} width="208" height="312" loading="lazy" decoding="async"/>
    </a>
    <div class="book-promo-body">
      <span class="book-promo-label">Now available · Dark fantasy</span>
      <h3><a href={href} rel="noopener sponsored" target="_blank">{book.title}</a></h3>
      <p class="book-promo-author">by {book.author}</p>
      <p class="book-promo-genre">{book.genre}</p>
      <p class="book-promo-blurb">{book.blurb}</p>
      <p class="book-promo-price">{book.price} on Kindle</p>
      <a class="btn" href={href} rel="noopener sponsored" target="_blank">Get it on Amazon →</a>
    </div>
  </div>
</aside>
